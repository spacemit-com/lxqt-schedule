+void LXQtWorldClock::refreshScheduleDates()
+{
+    if (!m_calendarWidget)
+        return;
+
+    QMap<QDate, QStringList> schedules;
+    QDBusInterface iface(QStringLiteral("org.lxqt.Schedule"),
+                         QStringLiteral("/org/lxqt/Schedule"),
+                         QStringLiteral("org.lxqt.Schedule"));
+    QDBusReply<QString> reply = iface.call(QStringLiteral("ListSchedules"));
+    if (reply.isValid()) {
+        const QJsonDocument doc = QJsonDocument::fromJson(reply.value().toUtf8());
+        const QJsonArray arr = doc.object().value(QLatin1String("schedules")).toArray();
+        for (const QJsonValue &v : arr) {
+            const QJsonObject obj = v.toObject();
+            const qlonglong dueEpoch = static_cast<qlonglong>(
+                obj.value(QLatin1String("due_epoch")).toDouble(0));
+            if (dueEpoch <= 0)
+                continue;
+            const QDateTime due = QDateTime::fromSecsSinceEpoch(dueEpoch);
+            const QString title = obj.value(QLatin1String("title")).toString();
+            schedules[due.date()].append(
+                due.time().toString(QLatin1String("HH:mm")) + QLatin1Char(' ') + title);
+        }
+    }
+    m_calendarWidget->setScheduleDates(schedules);
+}
